# Copy to .env (git-ignored). Only needed to rerun calls on API backends or to pull refs from Zotero.
# The claude and codex backends use your CLI logins.
OPENROUTER_API_KEY=

# Zotero (zotero.org/settings/keys), only for `make -C paper refs`.
ZOTERO_API_KEY=
ZOTERO_LIBRARY=users/<numeric id>
ZOTERO_COLLECTION=<collection key from the zotero.org URL>
